<Project>
  <PropertyGroup>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameFolder Condition="'$(GameFolder)' == ''">V:\Games\Steam\steamapps\common\Mount &amp; Blade II Bannerlord</GameFolder>
    <GameVersion>v1.4.8</GameVersion>
  </PropertyGroup>

  <!-- Steam Workshop modules the mods build against. IDs are the Workshop item ids. -->
  <PropertyGroup>
    <WorkshopFolder Condition="'$(WorkshopFolder)' == ''">$(GameFolder)\..\..\workshop\content\261550</WorkshopFolder>
    <HarmonyModuleDir Condition="'$(HarmonyModuleDir)' == ''">$(WorkshopFolder)\2859188632</HarmonyModuleDir>
    <McmModuleDir Condition="'$(McmModuleDir)' == ''">$(WorkshopFolder)\2859238197</McmModuleDir>
    <UiExtenderModuleDir Condition="'$(UiExtenderModuleDir)' == ''">$(WorkshopFolder)\2859222409</UiExtenderModuleDir>
  </PropertyGroup>
</Project>
